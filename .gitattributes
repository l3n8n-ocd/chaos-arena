# Keep Linux line endings for files that run on the server,
# even when committed from Windows. (Windows CRLF breaks bash scripts.)
* text=auto
*.sh   text eol=lf
*.conf text eol=lf
Dockerfile text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

*.png binary
*.jpg binary
*.gif binary

# Module 03+: files that run on the server keep Linux line endings
*.service   text eol=lf
*.logrotate text eol=lf
*.js        text eol=lf
*.json      text eol=lf
