# =============================================================================
# Chaos Arena settings (environment variables)
#
# This file is only an EXAMPLE and contains no real secrets.
# - On my laptop: the defaults work, nothing needs to be set.
# - On the AWS server: the real file is /etc/chaos-arena/chaos-arena.env,
#   created by module-03-cloud-services/scripts/02-deploy-app.sh, readable by
#   root only, and NEVER committed to Git.
# =============================================================================

NODE_ENV=production

# The app only listens on localhost; Nginx is the only door to the internet.
HOST=127.0.0.1
PORT=3000

# Where game data lives: memory | file | dynamo
STORE=dynamo

# AWS settings (no access keys! the EC2 instance's IAM role provides credentials)
AWS_REGION=ap-southeast-1
TABLE_NAME=chaos-arena
BUCKET_NAME=chaos-arena-123456789012-ap-southeast-1

# Game rules
WIN_AT=50
CHAOS_COOLDOWN_SEC=60

# Secret for POST /api/admin/reset. Generate with:  openssl rand -hex 24
ADMIN_TOKEN=change-me-to-a-long-random-string
